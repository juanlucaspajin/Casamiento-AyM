# =============================================================================
# VARIABLES DE ENTORNO REQUERIDAS (EJEMPLO)
# =============================================================================

# 1. Base de datos Neon Postgres (Persistencia de Mensajes)
# Inyectada automáticamente por la integración de Neon en Vercel Marketplace
# Formato: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:xxxxxxxx@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# (Opcional) Salt para hashing SHA-256 de las IPs en el rate limiting
RATE_LIMIT_SALT="casamiento-aym-secret-salt"

# 2. Álbum Compartido de Google Fotos
# Pega tu enlace aquí en .env.local o configúralo en Vercel -> Settings -> Environment Variables
NEXT_PUBLIC_GOOGLE_PHOTOS_URL=
